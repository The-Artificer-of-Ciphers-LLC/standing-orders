{
  "schemaVersion": 1,
  "id": "standing-orders",
  "role": "feature",
  "version": "0.6.0",
  "title": "Standing Orders",
  "description": "Project-wide, context-scoped business rules: conflict-gated planning, independent fail-first checks, and rule-to-check traceability.",
  "tier": "full",
  "requires": [],
  "engines": { "gsd": ">=1.19.0 <2.0.0" },
  "runtimeCompat": { "supported": ["*"], "unsupported": [] },
  "author": { "name": "The Artificer of Ciphers LLC", "url": "https://github.com/The-Artificer-of-Ciphers-LLC" },
  "homepage": "https://github.com/The-Artificer-of-Ciphers-LLC/standing-orders",
  "repository": "https://github.com/The-Artificer-of-Ciphers-LLC/standing-orders",
  "license": "MIT",
  "skills": ["standing-orders-promote", "standing-orders-conflict-review", "standing-orders-harden"],
  "agents": [],
  "hooks": [],
  "activationKey": "standing-orders.enabled",
  "config": {
    "standing-orders.enabled": { "type": "boolean", "default": false, "description": "Enable Standing Orders. Its loop hooks are inactive and its commands write nothing until this is true." },
    "standing-orders.block_on": { "type": "enum", "values": ["conflict", "conflict_or_missing", "never"], "default": "conflict", "description": "What blocks planning: conflicts and invalid rules (conflict), those plus missing checks of applicable test-tier orders (conflict_or_missing), or nothing (never)." },
    "standing-orders.max_bytes": { "type": "number", "default": 6000, "description": "UTF-8 byte cap for APPLICABLE.md, the planner's view of the applicable orders." }
  },
  "commands": [
    {
      "family": "standing-orders",
      "module": "standing-orders-router.cjs",
      "router": "routeStandingOrdersCommand",
      "subcommands": ["select", "conflicts", "coverage", "enforce", "trace", "impact", "stale", "validate", "promote", "semantic", "mutants"]
    }
  ],
  "steps": [
    {
      "point": "discuss:post",
      "ref": { "skill": "standing-orders-promote" },
      "produces": [".planning/standing-orders/ORDERS.yaml"],
      "consumes": [],
      "when": "standing-orders.enabled",
      "onError": "skip"
    },
    {
      "point": "plan:pre",
      "ref": { "command": "standing-orders select" },
      "produces": [".planning/standing-orders/APPLICABLE.md", ".planning/standing-orders/CONFLICTS.json", "STANDING-ORDERS.md"],
      "consumes": [],
      "when": "standing-orders.enabled",
      "onError": "halt"
    },
    {
      "point": "plan:post",
      "ref": { "command": "standing-orders coverage" },
      "produces": ["STANDING-ORDERS.md"],
      "consumes": [],
      "when": "standing-orders.enabled",
      "onError": "halt"
    },
    {
      "point": "execute:wave:post",
      "ref": { "command": "standing-orders enforce" },
      "produces": [".planning/standing-orders/ENFORCEMENT.json", "STANDING-ORDERS.md"],
      "consumes": [],
      "when": "standing-orders.enabled",
      "onError": "halt"
    },
    {
      "point": "ship:pre",
      "ref": { "command": "standing-orders trace" },
      "produces": [".planning/standing-orders/TRACE.jsonl"],
      "consumes": [],
      "when": "standing-orders.enabled",
      "onError": "skip"
    }
  ],
  "contributions": [
    {
      "point": "plan:pre",
      "into": "planner",
      "fragment": { "path": "fragments/plan-pre-planner.md" },
      "produces": [],
      "consumes": [".planning/standing-orders/APPLICABLE.md"],
      "when": "standing-orders.enabled",
      "onError": "skip"
    }
  ],
  "gates": [
    {
      "point": "discuss:post",
      "check": { "agentVerdict": { "ref": "standing-orders-conflict-review", "prompt": "Run the gsd-standing-orders-conflict-review skill for this phase. It proposes semantic conflicts between the applicable standing orders and the phase SPEC.md, asks the user to confirm or dismiss each one (a dismissal needs a reason; auto mode never dismisses), and ends with an advisory verdict line. This gate is advisory: report the verdict and never block." } },
      "when": "standing-orders.enabled",
      "blocking": false,
      "onError": "skip"
    },
    {
      "point": "plan:pre",
      "check": { "predicate": { "kind": "artifact-frontmatter-equals", "artifact": "STANDING-ORDERS.md", "field": "conflicts", "equals": "clear" } },
      "when": "standing-orders.enabled",
      "blocking": true,
      "onError": "halt"
    },
    {
      "point": "plan:post",
      "check": { "predicate": { "kind": "artifact-frontmatter-equals", "artifact": "STANDING-ORDERS.md", "field": "conflicts", "equals": "clear" } },
      "when": "standing-orders.enabled",
      "blocking": true,
      "onError": "halt"
    },
    {
      "point": "plan:post",
      "check": { "predicate": { "kind": "artifact-frontmatter-equals", "artifact": "STANDING-ORDERS.md", "field": "coverage", "equals": "complete" } },
      "when": "standing-orders.enabled",
      "blocking": true,
      "onError": "halt"
    },
    {
      "point": "execute:wave:post",
      "check": { "predicate": { "kind": "artifact-frontmatter-equals", "artifact": "STANDING-ORDERS.md", "field": "enforcement", "equals": "clear" } },
      "when": "standing-orders.enabled",
      "blocking": true,
      "onError": "halt"
    }
  ]
}
